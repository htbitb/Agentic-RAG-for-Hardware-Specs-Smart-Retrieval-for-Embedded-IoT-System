{"id": "339571822eff", "ts": "2026-10-25T08:46:26", "event": "tool_call", "tool": "compile_check", "permission": "sandboxed-exec", "server": "hw-sandbox", "args": {"code": "#include \"stm32g4xx.h\"\n\nvoid tim1_pa8_pwm_init(void)\n{\n    /* 1. Enable peripheral clocks for GPIOA and TIM1 */\n    RCC->AHB2ENR |= RCC_AHB2ENR_GPIOAEN;\n    RCC->APB2ENR |= RCC_APB2ENR_TIM1EN;\n\n    /* 2. Configure PA8 as Alternate Function AF6 (TIM1_CH1) */\n    GPIOA->MODER &= ~(GPIO_MODER_MODE8_Msk);\n    GPIOA->MODER |= (2U << GPIO_MODER_MODE8_Pos); /* AF mode (10b) */\n\n    GPIOA->AFR[1] &= ~(0xFU << ((8U - 8U) * 4U));\n    GPIOA->AFR[1] |= (6U << ((8U - 8U) * 4U));   /* AF6: TIM1_CH1 */\n\n    GPIOA->OSPEEDR |= (3U << GPIO_OSPEEDR_OSPEED8_Pos); /* Very high speed */\n\n    /* 3. Configure TIM1 time base for 20 kHz */\n    /* Timer clock = 170 MHz. Target = 20 kHz -> Counter period = 170 MHz / 20 kHz = 8500 cycles */\n    TIM1->PSC = 0U;\n    TIM1->ARR = 8500U - 1U; /* 8499 */\n\n    /* 4. Configure PWM duty cycle: 25% of 8500 = 2125 */\n    TIM1->CCR1 = 2125U;\n\n    /* 5. Configure Channel 1 as PWM Mode 1 (active while CNT < CCR1) with preload enabled */\n    TIM1->CCMR1 &= ~(TIM_CCMR1_CC1S | TIM_CCMR1_OC1M);\n    TIM1->CCMR1 |= (0x6U << TIM_CCMR1_OC1M_Pos) | TIM_CCMR1_OC1PE;\n\n    /* 6. Enable Channel 1 output */\n    TIM1->CCER |= TIM_CCER_CC1E;\n\n    /* 7. Enable Main Output (MOE bit in BDTR, required for advanced timers like TIM1) */\n    TIM1->BDTR |= TIM_BDTR_MOE;\n\n    /* 8. Generate an update event to transfer preloaded values to shadow registers */\n    TIM1->EGR = TIM_EGR_UG;\n\n    /* 9. Enable auto-reload preload and start timer */\n    TIM1->CR1 |= TIM_CR1_ARPE | TIM_CR1_CEN;\n}\n", "chip": "stm32g474"}, "latency_ms": 1040, "error": null, "session": "live-demo"}
